# Mobile end-user flow environment. Copy to .env and fill in.
# Maestro reads these with ${VAR} inside a flow; a credential never goes in the YAML.

# The package Maestro drives. com.vivahspot.app is the dev client or release build.
# Expo Go is host.exp.exponent, and clearState then wipes Expo Go itself, not your app.
MAESTRO_APP_ID=com.vivahspot.app

# How long to wait for the emulator or device to hand over a driver. WSL talking to a
# phone over adb is slower than a local emulator, so this is generous on purpose.
MAESTRO_DRIVER_STARTUP_TIMEOUT=120000

# The Frappe bench the app talks to during a flow.
API_URL=http://localhost:8000

# The reserved test identity. Same backend test mode as the vendor portal, same warning:
# never a real number. See DEFERRED.md D-24.
FAMILY_TEST_MOBILE=
FAMILY_TEST_OTP=
