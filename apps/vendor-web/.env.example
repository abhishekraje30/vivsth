# Vendor portal test environment. Copy to .env and fill in.
# .env is gitignored; .env.example is the only one that ships.

# Which environment the auth cache is keyed by. Sessions for different values never mix.
TEST_ENV=local

# The portal itself, what a vendor's browser points at.
BASE_URL=http://localhost:3000

# The Frappe bench serving /api/v2. Leave unset to skip every backend-dependent spec
# instead of failing them; the portal smoke test still runs.
API_URL=http://localhost:8000

# The reserved test identity. Requires a backend test mode that returns a fixed code for
# these numbers without calling MSG91 — see DEFERRED.md D-24.
# Never point these at a real number: the suite signs in as this identity on every run.
VENDOR_TEST_MOBILE=
VENDOR_TEST_OTP=

# Narrated how-to guides, rendered from every passing test that logs steps.
# On by default locally, off on CI unless set to 1. Rendering needs Piper and ffmpeg; when
# guides are on and either is missing, the run reports it as a failure rather than quietly
# producing silent video.
NARRATED_GUIDES=1

# Piper binary, installed with `uv tool install piper-tts`.
PIPER_BIN=piper

# Absolute path to the voice model. Leave empty for the default,
# ~/.local/share/piper-voices/en_US-ljspeech-high.onnx — a public-domain voice, chosen
# because these guides are client deliverables and several Piper voices are non-commercial.
PIPER_VOICE=
